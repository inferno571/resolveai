# ============================================
# ResolveAI Backend Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- LLM Provider ---
# Options: "ollama" (local, default) or "gemini" (API)
LLM_PROVIDER=ollama

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# --- Gemini API ---
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Storage ---
CHROMA_PERSIST_DIR=./data/chroma_db
SQLITE_DB_PATH=./data/resolveai.db

# --- CBR Weights (must sum to 1.0) ---
CBR_WEIGHT_PROBLEM=0.40
CBR_WEIGHT_EVIDENCE=0.25
CBR_WEIGHT_ENTITY=0.20
CBR_WEIGHT_ENVIRONMENT=0.15

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
