# ============================================
# ResolveAI — Git Ignore Rules
# ============================================

# Environment Variables & Secrets (CRITICAL: Never commit API keys)
.env
*.env
!.env.example
backend/.env

# Python Virtual Environments & Packages
.venv/
venv/
env/
ENV/
backend/.venv/
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
eggs/
.eggs/

# Persistent Local Databases & Vector Stores
backend/data/chroma_db/
backend/data/*.db
backend/data/resolveai.db
*.db
*.sqlite
*.sqlite3

# Node & Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
dist-ssr/
*.local

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & OS Specific
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
